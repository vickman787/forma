APP_MODE=live
# Local storage is allowed only with loopback URLs; public hosting requires PostgreSQL and HTTPS.
LOCAL_ONLY=true
GENERATION_PROVIDER=openai
APP_URL=http://127.0.0.1:3000
# Public hosting requires PostgreSQL; localhost can use persistent SQLite.
DATABASE_URL=
DATA_DIRECTORY=.forma/live-local
SESSION_SECRET=
ADMIN_WALLETS=
SUPPORT_EMAIL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_RESEARCH_MODEL=
# Explicit paid-call gate; leave false until user authorization.
ALLOW_PAID_API_CALLS=false
MAX_OUTPUT_TOKENS=2500
MAX_JOB_COST_USD=
# Optional approved testing allocation. Reserves the full per-job estimate per request,
# including ambiguous/failed requests. Estimates do not guarantee provider billing.
PROVIDER_BUDGET_ID=
PROVIDER_TOTAL_BUDGET_USD=
MAX_INPUT_COST_PER_MILLION=
MAX_OUTPUT_COST_PER_MILLION=
MAX_SEARCH_COST_USD=
QIE_CHAIN_ID=1990
QIE_RPC_URL=https://rpc1mainnet.qie.digital
QIE_EXPLORER_URL=https://mainnet.qie.digital
QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
QUSDC_DECIMALS=6
SERVICE_PRICE_BASE_UNITS=1000000
ESCROW_ADDRESS=
TREASURY_ADDRESS=
OPERATOR_ADDRESS=
PREVIEW_ORIGIN=http://127.0.0.1:4317
LIVE_PAYMENTS_ENABLED=false
# Set only after deployment, token and settlement checks pass.
LIVE_VERIFICATION_COMPLETE=false
FFMPEG_PATH=

# Optional exact registered order for owner-operated loopback checkout validation only.
LOCAL_CHECKOUT_ORDER_ID=

# Enable only under an explicitly approved registration/delivery gas allowance.
ALLOW_OPERATOR_TRANSACTIONS=false
OPERATOR_POLICY_ID=
OPERATOR_TOTAL_GAS_QIE=
OPERATOR_MAX_TX_GAS_QIE=
OPERATOR_POLICY_EXPIRES_AT=
OPERATOR_POLICY_ACTIONS=create,deliver
OPERATOR_POLICY_ORDER_ID=
FORMA_DEPLOYER_PRIVATE_KEY=
